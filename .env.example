# ------------------------------------------------------------------
# DeepResearch Agent — environment template
# Copy to .env and fill in your own values. .env is gitignored.
# ------------------------------------------------------------------

# --- Anthropic ----------------------------------------------------
# Key: https://console.anthropic.com → Settings → API Keys
# Set a $50/mo spend limit at https://console.anthropic.com/settings/limits
ANTHROPIC_API_KEY=sk-ant-...

# Model id. Examples: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-5

# --- LangSmith (observability) ------------------------------------
# Personal Access Token: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=deepresearch-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Optional: Ollama (local, no API cost) ------------------------
# Uncomment to route LLM calls to a local Ollama server.
# Requires: `ollama serve` running + a tool-calling model pulled
# (e.g. `ollama pull qwen2.5:7b`).
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434
